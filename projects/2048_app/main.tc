// Tiny-C Dense DFS Backtracker Maze - 96x64 Display
// RAM optimized: removed neighbors[] array via reservoir sampling.

#include <stdlib/gfx.tc>
#include <stdlib/rand.tc>

byte bit_mask[8] = {1,2,4,8,16,32,64,128};
byte visited[146];

byte stack[256];
word stack_ptr;

word cur_cell;
byte cur_x;
byte cur_y;

byte n_count;
byte dir;

word next_cell;
byte next_x;
byte next_y;

word delay_w;
word clear_i;

byte is_visited(word cell) {
  if ((visited[cell / 8] & bit_mask[cell % 8]) != 0) {
    return 1;
  }
  return 0;
}

void mark_visited(word cell) {
  visited[cell / 8] = visited[cell / 8] | bit_mask[cell % 8];
}

void clear_visited() {
  clear_i = 0;
  while (clear_i < 146) {
    visited[clear_i] = 0;
    clear_i = clear_i + 1;
  }
}

void delay(word counts) {
  delay_w = 0;
  while (delay_w < counts) {
    delay_w = delay_w + 1;
  }
}

void do_backtrack() {
  dir = stack[stack_ptr - 1];
  stack_ptr = stack_ptr - 1;

  if (dir == 0) { cur_y = cur_y + 1; cur_cell = cur_cell + 43; }
  if (dir == 1) { cur_x = cur_x - 1; cur_cell = cur_cell - 1; }
  if (dir == 2) { cur_y = cur_y - 1; cur_cell = cur_cell - 43; }
  if (dir == 3) { cur_x = cur_x + 1; cur_cell = cur_cell + 1; }
}

void main() {
  lcd_init();

  while (1) {
    lcd_clear();
    srand_auto();
    clear_visited();

    cur_x = rand_range(43);
    cur_y = rand_range(27);
    cur_cell = (cur_y * 43) + cur_x;

    mark_visited(cur_cell);
    stack_ptr = 0;

    draw_rect(5 + (cur_x * 2), 5 + (cur_y * 2), 1, 1);

    while (1) {
       n_count = 0;

      if (cur_y > 0) {
        if (is_visited(cur_cell - 43) == 0) {
          n_count = n_count + 1;
          if (rand_range(n_count) == 0) {
            dir = 0;
          }
        }
      }

      if (cur_x < 42) {
        if (is_visited(cur_cell + 1) == 0) {
          n_count = n_count + 1;
          if (rand_range(n_count) == 0) {
            dir = 1;
          }
        }
      }

      if (cur_y < 26) {
        if (is_visited(cur_cell + 43) == 0) {
          n_count = n_count + 1;
          if (rand_range(n_count) == 0) {
            dir = 2;
          }
        }
      }

      if (cur_x > 0) {
        if (is_visited(cur_cell - 1) == 0) {
          n_count = n_count + 1;
          if (rand_range(n_count) == 0) {
            dir = 3;
          }
        }
      }

      if (n_count > 0 & stack_ptr < 600) {

        if (dir == 0) {
          next_x = cur_x;
          next_y = cur_y - 1;
          next_cell = cur_cell - 43;
        }

        if (dir == 1) {
          next_x = cur_x + 1;
          next_y = cur_y;
          next_cell = cur_cell + 1;
        }

        if (dir == 2) {
          next_x = cur_x;
          next_y = cur_y + 1;
          next_cell = cur_cell + 43;
        }

        if (dir == 3) {
          next_x = cur_x - 1;
          next_y = cur_y;
          next_cell = cur_cell - 1;
        }

        mark_visited(next_cell);

        draw_rect(5 + (cur_x + next_x), 5 + (cur_y + next_y), 1, 1);
        draw_rect(5 + (next_x * 2), 5 + (next_y * 2), 1, 1);

        stack[stack_ptr] = dir;
        stack_ptr = stack_ptr + 1;

        cur_x = next_x;
        cur_y = next_y;
        cur_cell = next_cell;

      } else {
        if (stack_ptr > 0) {
          do_backtrack();
        } else {
          break;
        }
      }
    }

    delay(10000);
  }
}
