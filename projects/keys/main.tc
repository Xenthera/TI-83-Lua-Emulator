#include <stdlib/key.tc>

// Wait for Enter, then draw while arrows are held. Clear returns to the prompt.

void main() {
  byte k;
  byte x;
  byte y;
  byte draw;

  lcd_init();
  lcd_clear();
  draw_string(0, 0, "PRESS ENTER");
  draw = 0;

  while (1) {
    if (draw == 0) {
      k = key_wait();
      if (k == 0x09) {
        lcd_clear();
        x = 48;
        y = 32;
        draw_pixel(x, y);
        draw = 1;
      }
    } else {
      if (key_down(0x04)) {
        if (y > 0) {
          y = y - 1;
          draw_pixel(x, y);
        }
      }
      if (key_down(0x01)) {
        if (y < 63) {
          y = y + 1;
          draw_pixel(x, y);
        }
      }
      if (key_down(0x02)) {
        if (x > 0) {
          x = x - 1;
          draw_pixel(x, y);
        }
      }
      if (key_down(0x03)) {
        if (x < 95) {
          x = x + 1;
          draw_pixel(x, y);
        }
      }
      if (key_down(0x0F)) {
        while (key_down(0x0F)) {
        }
        lcd_clear();
        draw_string(0, 0, "PRESS ENTER");
        draw = 0;
      }
    }
  }
}
