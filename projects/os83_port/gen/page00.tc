// flash page 0 cpu 0x0000 (offset 0x0000)
void p00_rst00_boot() {
  byte a;
  byte b;
  byte c;
  byte d;
  byte e;
  byte h;
  byte l;
  a = hw_in(PORT_STATUS);
  a = a & 0x80;
  goto lab_p00_L_01D0;
  lab_p00_L_01D0:
  a = 0x1F;
  if (flag_z()) goto lab_p00_L_01DA;
  a = 0x03;
  hw_out(0x0E, a);
  a = 0x7F;
  lab_p00_L_01DA:
  mmu_set_bank_a(a);
  a = 0x77;
  hw_out(PORT_INTACK, a);
  /* jp 0x80D5 - other page/RAM */
}

