  /* add hl,sp */
  /* ld d,(hl) */
  /* dec hl */
  /* ld e,(hl) */
  /* inc de */
  /* inc de */
  /* ld (hl),e */
  /* inc hl */
  /* ld (hl),d */
  a = hw_in(PORT_MMU_A);
  c = a;
  /* dec hl */
  /* dec hl */
  /* dec hl */
  /* ld (hl),a */
  /* dec hl */
  /* ld (hl),0x2B */
  /* dec hl */
  /* ld (hl),0x34 */
  /* dec de */
  /* ld a,(de) */
  h = a;
  /* dec de */
  /* ld a,(de) */
  l = a;
  b = 0x00;
  /* bit 7,h */
  if (flag_nz()) goto lab_p00_L_2A6D;
  /* bit 6,h */
  if (flag_z()) goto lab_p00_L_2A73;
  /* res 6,h */
