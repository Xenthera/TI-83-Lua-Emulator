  e = l;
  d = h;
  /* ld hl,0x0008 */
  /* add hl,sp */
  /* ld a,(de) */
  /* ld (hl),a */
  /* inc de */
  /* inc hl */
  /* ld a,(de) */
  /* ld (hl),a */
  /* inc de */
  a = b;
  a = a | a;
  if (flag_z()) goto lab_p00_L_2AA6;
  /* ld a,(de) */
  /* neg */
  a = a + b;
  goto lab_p00_L_2AAB;
  lab_p00_L_2AA6:
  /* ld a,(de) */
  a = a | a;
  if (flag_nz()) goto lab_p00_L_2AAB;
  a = c;
  lab_p00_L_2AAB:
  p00_mmu_set_bankA_2();
