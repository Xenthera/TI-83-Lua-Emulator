// Keypad ABI (bare metal - we own port 01, no TI-OS GetCSC).
//
// Natives (always available):
//   byte key_scan();           // 0 if none, else GetCSC-style scancode
//   byte key_wait();           // block until press+release, return code
//   byte key_down(byte code);  // 1 if that key is held right now
//
// Scancodes match WikiTI / TI-OS sk* (hex):
//   0x01 down   0x02 left   0x03 right  0x04 up
//   0x09 enter  0x0A +      0x0B -      0x0C *      0x0D /   0x0E ^   0x0F clear
//   0x11 (-)    0x12 3      0x13 6      0x14 9      0x15 )   0x16 tan 0x17 vars
//   0x19 .      0x1A 2      0x1B 5      0x1C 8      0x1D (   0x1E cos 0x1F prgm
//   0x21 0      0x22 1      0x23 4      0x24 7      0x25 ,   0x26 sin 0x27 apps
//   0x2A sto    0x2B ln     0x2C log    0x2D x2     0x2E x-1 0x2F math 0x30 alpha
//   0x31 graph  0x32 trace  0x33 zoom   0x34 window 0x35 Y=  0x36 2nd  0x37 mode 0x38 del
//
// Example:
//   byte k;
//   k = key_wait();
//   if (k == 0x09) { /* enter */ }
